<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash for Android 11 (Android 12+ uses the SplashScreen attributes in values-v31/styles.xml).
     The mark is drawn at 288dp, the size Android 12+ uses for an icon without a background, so both look
     the same and the Flutter splash (lib/src/ui/splash.dart) picks up at the same position. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
